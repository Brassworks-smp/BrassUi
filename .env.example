# Copy this file to `.env` and fill in the values. `.env` is gitignored — it never leaves your machine.
#
# These are the only values needed to publish to maven.opnsoc.org from your machine. The root
# build.gradle reads `.env` directly, so a release is just `./gradlew publish` — no sourcing needed.
# Real environment variables or `-P` properties override the file when present.
#
# BRASSWORKS_MAVEN_USER: your publishing user on maven.opnsoc.org (defaults to `brassui`).
# BRASSWORKS_MAVEN_KEY:  the publishing key. Keep it secret; never commit `.env`.

BRASSWORKS_MAVEN_USER=brassui
BRASSWORKS_MAVEN_KEY=
