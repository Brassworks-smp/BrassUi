# Copy this file to `.env` and fill in the values. `.env` is gitignored — it never leaves your machine.
#
# These are only needed for publishing to GitHub Packages FROM YOUR MACHINE (`./gradlew publish`).
# CI does not use this file: the Publish workflow gets its token from GitHub Actions automatically.
#
# The names match what build.gradle reads from the environment. To publish locally:
#
#   set -a; source .env; set +a
#   ./gradlew publish
#
# GITHUB_ACTOR is your GitHub username. GITHUB_TOKEN is a Personal Access Token (classic) with the
# `write:packages` scope (which also pulls in `read:packages` and `repo`). Create one at:
#   https://github.com/settings/tokens

GITHUB_ACTOR=salem-5
GITHUB_TOKEN=
